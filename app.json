{
  "expo": {
    "name": "monhealth",
    "slug": "monhealth",
    "version": "1.0.0",
    "scheme": "monhealth",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./public/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./public/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vanhuutoan27.monhealth"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69c859ab-3e54-4e1f-a3eb-d2545f9abce2"
      }
    }
  }
}
